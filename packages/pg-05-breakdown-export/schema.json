{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PG-05 neutral production breakdown v1",
  "$comment": "Structural schema only. Rust enforces UTF-8 byte limits, XML characters, global IDs/references, unique category/name pairs and single day assignment. Enable format checking for dates.",
  "type": "object",
  "required": [
    "version",
    "elements",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "elements": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "scenes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "shooting_days": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/shooting_day"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "id",
        "category",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "category": {
          "enum": [
            "cast",
            "background_actors",
            "stunts",
            "vehicles",
            "props",
            "camera",
            "special_effects",
            "wardrobe",
            "makeup_hair",
            "animals",
            "animal_wrangler",
            "music",
            "sound",
            "art_department",
            "set_dressing",
            "greenery",
            "special_equipment",
            "security",
            "additional_labor",
            "visual_effects",
            "mechanical_effects",
            "miscellaneous"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        }
      },
      "additionalProperties": false
    },
    "element_ref": {
      "type": "object",
      "required": [
        "element_id"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "number",
        "int_ext",
        "set",
        "time_of_day",
        "pages_eighths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "number": {
          "type": "string",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "int_ext": {
          "enum": [
            "interior",
            "exterior",
            "interior_exterior"
          ]
        },
        "set": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "time_of_day": {
          "enum": [
            "day",
            "night",
            "dawn",
            "dusk",
            "morning",
            "afternoon",
            "evening",
            "continuous",
            "later"
          ]
        },
        "pages_eighths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80000
        },
        "synopsis": {
          "type": "string",
          "maxLength": 65536
        },
        "notes": {
          "type": "string",
          "maxLength": 65536
        },
        "elements": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "type": "object",
            "required": [
              "element_id"
            ],
            "properties": {
              "element_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000,
                "default": 1
              }
            },
            "additionalProperties": false
          }
        },
        "script_day": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        }
      },
      "additionalProperties": false
    },
    "shooting_day": {
      "type": "object",
      "required": [
        "id",
        "label",
        "scenes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scenes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pg-06/shot-list-v1.schema.json",
  "title": "Neutral shot list v1",
  "description": "Structural checks only. Rust validates UTF-8 byte budgets, references, rational rates, timecode, URI syntax and aggregate frame limits. Unknown fields are ignored.",
  "type": "object",
  "required": ["version", "frame_rate", "shots"],
  "properties": {
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/optionalText" },
    "frame_rate": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 1000 },
        {
          "type": "object",
          "required": ["num", "den"],
          "properties": {
            "num": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "den": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          }
        }
      ]
    },
    "record_start": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]:[0-9]{2,3}(?![\\s\\S])", "maxLength": 12 }
      ]
    },
    "resolution": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 32768 },
            { "type": "integer", "minimum": 1, "maximum": 32768 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "shots": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "duration_frames"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\ufffe\\uffff\\u2028\\u2029]+(?![\\s\\S])"
          },
          "name": { "$ref": "#/$defs/optionalText" },
          "duration_frames": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
          "gap_before_frames": {
            "anyOf": [
              { "type": "null" },
              { "$ref": "#/$defs/frames" }
            ]
          },
          "media": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192,
                    "pattern": "^([fF][iI][lL][eE]|[hH][tT][tT][pP][sS])://[^\\u0000-\\u0020\\u007f-\\u009f]+(?![\\s\\S])"
                  },
                  "source_in_frame": {
                    "anyOf": [
                      { "type": "null" },
                      { "$ref": "#/$defs/frames" }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "frames": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
    "optionalText": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ufffe\\uffff\\u2028\\u2029]*(?![\\s\\S])"
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PG-10 neutral minimap document v1",
  "description": "Shape only. Runtime checks UTF-8 ID byte limits, references, uniqueness, finite geometry and budgets. Polyline points describe a complete world-space route, including endpoints.",
  "type": "object",
  "required": ["version", "nodes", "edges", "viewport"],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "nodes": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "width", "height"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u0020\\u007f-\\u009f])?$"
          },
          "x": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          },
          "y": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          },
          "width": {
            "type": "number",
            "minimum": 0.000001,
            "maximum": 2000000000
          },
          "height": {
            "type": "number",
            "minimum": 0.000001,
            "maximum": 2000000000
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u0020\\u007f-\\u009f])?$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u0020\\u007f-\\u009f])?$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u0020\\u007f-\\u009f])?$"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "viewport": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "width": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 2000000000
        },
        "height": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 2000000000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

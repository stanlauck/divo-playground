{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0. Runtime additionally validates calendar dates, BCP-47 syntax, unique section IDs, rectangular tables, and aggregate tree limits.",
  "title": "Neutral report v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Well-formed BCP-47 tag; validated by runtime without registry lookup."
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "sections": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "required": [
    "version",
    "title",
    "sections"
  ],
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "blocks": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/section"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "title",
        "blocks"
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "heading"
            },
            "text": {
              "type": "string"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "type",
            "text",
            "level"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bullets"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "numbered"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "columns",
            "rows"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "key_values"
            },
            "pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "type",
            "pairs"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "code"
            },
            "text": {
              "type": "string"
            },
            "language": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9_+\\-]+$"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "quote"
            },
            "text": {
              "type": "string"
            },
            "attribution": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "callout"
            },
            "kind": {
              "enum": [
                "note",
                "warning",
                "error",
                "success"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "page_break"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "image"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*[\\\\:?#\\x00-\\x1f\\x7f-\\x9f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*?/$).+$"
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            },
            "width_percent": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "type",
            "path"
          ]
        }
      ]
    }
  }
}

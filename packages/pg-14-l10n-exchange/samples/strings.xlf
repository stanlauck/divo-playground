    <unit id="lighthouse.keeper.greeting">
      <notes>
        <note category="context">Lighthouse lamp room, first visit, evening</note>
        <note category="character">Keeper Odile</note>
      </notes>
      <segment state="translated">
        <source>You came up all those stairs? Sit, the kettle is warm.</source>
        <target>Du bist all die Stufen hochgestiegen? Setz dich, der Kessel ist warm.</target>
      </segment>
    </unit>
    <unit id="lighthouse.keeper.storm">
      <notes>
        <note category="context">Storm warning, repeated on every visit</note>
        <note category="character">Keeper Odile</note>
        <note category="comment">Quotes are part of the line; keep them.</note>
      </notes>
      <segment state="initial">
        <source>When the bell rings twice, "close" the shutters &amp; stay inside.</source>
      </segment>
    </unit>
    <unit id="lighthouse.player.reply">
      <notes>
        <note category="character">Visitor</note>
      </notes>
      <segment state="reviewed">
        <source>Line one.
Line two, after a pause.</source>
        <target>Zeile eins.
Zeile zwei, nach einer Pause.</target>
      </segment>
    </unit>
    <unit id="ui.button.continue" slr:sizeRestriction="12">

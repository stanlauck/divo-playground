      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "You came back.",
      "line_id": "3a0001",
      "line": 4,
      "col": 6
    },
    {
      "id": "Start:2",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Narrator",
      "text": "The lamp above the desk flickers.",
      "line_id": "3a0002",
      "tags": [
        "atmosphere",
        "night"
      ],
      "line": 5,
      "col": 11
    },
    {
      "id": "Start:3",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Bob",
      "text": "Press # to continue.",
      "line_id": "3a0003",
      "line": 6,
      "col": 6
    },
    {
      "id": "Start:4",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Cy",
      "text": "An escaped # stays literal text.",
      "line_id": "3a0004",
      "line": 7,
      "col": 5
    },
    {
      "id": "Start:5",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Dee",
      "text": "The url http://example.com/a#b is prose.",
      "line_id": "3a0005",
      "line": 8,
      "col": 6
    },
    {
      "id": "Start:6",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Eve",
      "text": "Quoted \"# not a tag\" is prose too.",
      "line_id": "3a0006",
      "line": 9,
      "col": 6
    },
    {
      "id": "Start:7",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Fay",
      "text": "Tag then a trailing comment.",
      "line_id": "3a0007",
      "tags": [
        "kept"
      ],
      "line": 10,
      "col": 6
    },
    {
      "id": "Start:8",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "text": "No speaker on this line at all.",
      "line_id": "3a0008",
      "line": 11,
      "col": 1
    },
    {
      "id": "Start:9",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "text": "10:30 in the morning is not a speaker.",
      "line_id": "3a0009",
      "line": 12,
      "col": 1
    },
    {
      "id": "Start:10",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Mary-Jane",
      "text": "Hyphens and apostrophes are allowed: it's fine.",
      "line_id": "3a0010",
      "line": 13,
      "col": 12
    },
    {
      "id": "Start:11",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "_Narrator",
      "text": "A leading underscore is allowed.",
      "line_id": "3a0011",
      "line": 14,
      "col": 12
    },
    {
      "id": "Start:12",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "Inline comment after text.",
      "line": 15,
      "col": 6
    }
  ],

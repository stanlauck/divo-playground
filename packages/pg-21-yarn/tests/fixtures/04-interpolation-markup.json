      "markup": true,
      "line": 5,
      "col": 6
    },
    {
      "id": "Start:4",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "Escaped \\[not markup\\] here.",
      "line_id": "4a0003",
      "line": 6,
      "col": 6
    },
    {
      "id": "Start:5",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "Count {$gold} while [bold color=\"red\"]this[/bold] glows.",
      "line_id": "4a0004",
      "markup": true,
      "line": 7,
      "col": 6
    },
    {
      "id": "Start:6",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "A bare [ bracket is not markup.",
      "line_id": "4a0005",
      "line": 8,
      "col": 6
    },
    {
      "id": "Start:7",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "An unclosed [wave tag stays prose.",
      "line_id": "4a0006",
      "line": 9,
      "col": 6
    },
    {
      "id": "Start:8",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "Plain text with nothing special.",
      "line_id": "4a0007",
      "line": 10,
      "col": 6
    },
    {
      "id": "Start:9",
      "source": 0,
      "title": "Start",
      "kind": "line",
      "speaker": "Ada",
      "text": "Markup in a \"quoted [wave] span\" still counts.",
      "line_id": "4a0008",
      "markup": true,
      "line": 11,
      "col": 6
    }
